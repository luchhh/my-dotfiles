      "mcp__onshape__get_parts",
      "mcp__onshape__get_features",
      "mcp__onshape__get_variables",
      "mcp__onshape__get_assembly",
      "mcp__onshape__get_assembly_features",
      "mcp__onshape__get_assembly_positions",
      "mcp__onshape__get_body_details",
      "mcp__onshape__get_face_coordinate_system",
      "mcp__onshape__get_bounding_box",
      "mcp__onshape__check_assembly_interference"
