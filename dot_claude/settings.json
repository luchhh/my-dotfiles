      "mcp__onshape__create_boolean",
      "mcp__onshape__create_mate_connector",
      "mcp__onshape__create_fastened_mate",
      "mcp__onshape__create_slider_mate",
      "mcp__onshape__create_revolute_mate",
      "mcp__onshape__create_cylindrical_mate",
      "mcp__onshape__transform_instance",
      "mcp__onshape__set_instance_position",
      "mcp__onshape__align_instance_to_face",
